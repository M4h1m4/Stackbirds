# -----------------------------------------------------------------------------
# StackBirds Invoice Processor — environment variables
# Copy to .env and fill in values. Run without frontend: API only.
# -----------------------------------------------------------------------------

# ----- Required for full pipeline (extraction → matching → completion) -----
OPENAI_API_KEY=sk-...your-openai-api-key...
OPENAI_MODEL=gpt-4o-mini

# ----- Storage -----
# SQLite: path to metadata DB (invoices, processings, states, extraction, matching, clarification)
SQLITE_PATH=./data/jobs.db

# MongoDB: document store for PDF attachments
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=stackbirds

# ----- Excel (matching phase) -----
# Optional. If unset, the app looks for any .xlsx in the project data/ directory
# (prefers Stackbirds_Assignment_Invoice_Extract_100_Rows.xlsx).
# EXCEL_PATH=./data/Stackbirds_Assignment_Invoice_Extract_100_Rows.xlsx

# ----- Optional: variance threshold (used by LLM context; default 0.10) -----
# VARIANCE_THRESHOLD=0.10

# ----- Base URL (for results link in email; frontend URL when you add it) -----
BASE_URL=http://localhost:5173

# ----- Email (IMAP) — for Option B (run email poller directly) -----
# Set these to poll your inbox; then run: uv run python -m backend.ingestion.email_poller
# Gmail: use an App Password (https://support.google.com/accounts/answer/185833)
IMAP_HOST=imap.gmail.com
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX

# ----- Optional: SMTP (send results link email to user) -----
# Not implemented in poller yet; BASE_URL is used for the link in logs.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
